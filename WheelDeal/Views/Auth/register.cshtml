@{
    Layout = null;
    ViewData["Title"] = "Register";
}
@model WheelDeal.Models.User

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Register - WheelDeal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f2f5;
        }

        .register-wrapper {
            min-height: 100vh;
        }

        .brand-panel {
            max-width: 500px;
        }

        .brand-name {
            font-size: 3rem;
            font-weight: bold;
            color: #198754;
        }

        .tagline {
            font-size: 1.25rem;
            color: #333;
        }

        .card {
            border-radius: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="container register-wrapper d-flex flex-column justify-content-center align-items-center">
        <div class="row w-100 justify-content-center align-items-center">
            <!-- Left Branding Panel -->
            <div class="col-md-6 text-center text-md-start mb-5 mb-md-0 px-4 brand-panel">
                <h1 class="brand-name">WheelDeal</h1>
                <p class="tagline mt-3">
                    Join now to access amazing deals on new and used cars.<br />
                    Stay informed with the latest reviews and news!
                </p>
            </div>

            <!-- Right Register Form -->
            <div class="col-md-5">
                <div class="card shadow p-4">
                    <h4 class="text-center mb-4">Create Your Account</h4>

                    <form method="post" asp-antiforgery="true" onsubmit="return validatePasswords()">
                        @Html.AntiForgeryToken()

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" asp-for="First_Name" placeholder="First Name" required />
                                    <label asp-for="First_Name">First Name</label>
                                    <div class="text-danger">@Html.ValidationMessageFor(model => model.First_Name)</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" asp-for="Last_Name" placeholder="Last Name" required />
                                    <label asp-for="Last_Name">Last Name</label>
                                    <div class="text-danger">@Html.ValidationMessageFor(model => model.Last_Name)</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" asp-for="Email" placeholder="Email" required />
                            <label asp-for="Email">Email</label>
                            <div class="text-danger">@Html.ValidationMessageFor(model => model.Email)</div>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" asp-for="Contact" placeholder="Contact Number" required />
                            <label asp-for="Contact">Contact Number</label>
                            <div class="text-danger">@Html.ValidationMessageFor(model => model.Contact)</div>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" asp-for="Password" id="Password" placeholder="Password" required />
                            <label asp-for="Password">Password</label>
                            <div class="text-danger">@Html.ValidationMessageFor(model => model.Password)</div>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="ConfirmPassword" name="confirmPassword" placeholder="Re-enter Password" required />
                            <label for="ConfirmPassword">Re-enter Password</label>
                        </div>

                        <div id="passwordError" class="text-danger mb-3 d-none">Passwords do not match.</div>

                        <button type="submit" class="btn btn-success w-100">Register</button>
                    </form>

                    <p class="mt-4 text-center">
                        Already have an account?
                        <a asp-controller="Auth" asp-action="Login" class="text-success fw-semibold">Login here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function validatePasswords() {
            const pass = document.getElementById('Password').value;
            const confirm = document.getElementById('ConfirmPassword').value;
            const error = document.getElementById('passwordError');

            if (pass !== confirm) {
                error.classList.remove('d-none');
                return false;
            }

            error.classList.add('d-none');
            return true;
        }
    </script>
</body>
</html>
