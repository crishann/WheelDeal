@{
    ViewData["Title"] = "News & Reviews";
}

<section class="py-4">
    <div class="container">
        <h2 class="mb-4 text-success">Latest News & Reviews</h2>

        <div class="row gy-4">
            <!-- Article 1 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">🚗 Toyota Vios 2025 Launched in PH</h5>
                        <p class="card-text text-muted">May 15, 2025</p>
                        <p class="card-text">Toyota refreshes its bestselling sedan with a modern design and enhanced fuel efficiency. A great pick for first-time car buyers.</p>
                        <a href="#" class="btn btn-sm btn-outline-success">Read more</a>
                    </div>
                </div>
            </div>

            <!-- Article 2 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">⚡ Hyundai Ioniq 6 Review: EV of the Future?</h5>
                        <p class="card-text text-muted">May 10, 2025</p>
                        <p class="card-text">This futuristic EV delivers sleek looks and top-tier tech. But is it practical for Philippine roads? We find out.</p>
                        <a href="#" class="btn btn-sm btn-outline-success">Read more</a>
                    </div>
                </div>
            </div>

            <!-- Article 3 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">🛻 Ford Ranger 2025: Still King of Pickups?</h5>
                        <p class="card-text text-muted">May 8, 2025</p>
                        <p class="card-text">We put the new Ford Ranger to the test across both city and off-road terrain. Here's how it held up under pressure.</p>
                        <a href="#" class="btn btn-sm btn-outline-success">Read more</a>
                    </div>
                </div>
            </div>

            <!-- Article 4 -->
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">🔋 Should You Buy an EV in 2025?</h5>
                        <p class="card-text text-muted">May 5, 2025</p>
                        <p class="card-text">EVs are growing in popularity. We explore the top electric vehicles available in the Philippines and whether they’re worth the switch today.</p>
                        <a href="#" class="btn btn-sm btn-outline-success">Read more</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
