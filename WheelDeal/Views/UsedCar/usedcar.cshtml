@{
    ViewData["Title"] = "New Car";
}

<div class="container mt-4">
    <div class="col-md-15">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title fw-bold">WheelDeal</h5>
                <p>
                    WheelDeal brings you the best deals on used cars in the Philippines for 2025 with updated listings and prices. 
                    Choose from a wide selection of pre-owned vehicles across various brands and models. 
                    Whether you're looking for a reliable sedan, a rugged SUV, a practical pickup, a stylish hatchback, or a touch of luxury—there’s a used car for every type of buyer.
                    <br/>
                    <br/>
                    We feature trusted listings from verified sellers, offering great value on well-maintained vehicles from popular brands like Nissan, Toyota, Hyundai, and more. 
                    Explore options based on your budget, preferred body type, brand, fuel type, transmission, mileage, year model, and seating capacity to find the perfect match.
                    <br />
                    <br />
                    Discover certified used cars, low-mileage units, and special deals. 
                    Stay informed with updated listings, price trends, and expert tips for buying secondhand cars in the Philippines.
                </p>
            </div>
        </div>
    </div>

    <br />

